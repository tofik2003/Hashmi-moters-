<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash-screen emblem: gold ring with a bold "H" monogram.
    Kept inside the central safe zone so the system's circular mask
    never clips the artwork.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gold ring -->
    <path
        android:fillColor="#FFC53D"
        android:fillType="evenOdd"
        android:pathData="M20,54 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0 M30,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0" />

    <!-- Bold white "H" monogram -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,38 h4 v32 h-4 z M58,38 h4 v32 h-4 z M46,49 h16 v10 h-16 z" />
</vector>
